# Encrypted blobs are binary: never let a text filter (autocrlf) touch their bytes.
*.enc binary

# The on-device spatial tables and their golden file are generated by the worker
# (PixlAudio-iOS cloud/runpod-worker/schema/v1/spatial/) and carried here as byte-identical copies
# (handoff/, app assets, unit-test resources). Always LF, on every platform: with autocrlf a
# Windows checkout would otherwise append a CR and the copy in the APK would differ.
spatial_preview*.json text eol=lf

# The brain's golden vectors and their text corpus are compared byte for byte, here and in the iOS
# repo (docs/brain-spec.md, 10.4). Always LF: with autocrlf a Windows checkout would add a CR and
# every hash in MANIFEST.sha256 would be wrong.
brain/src/test/resources/brain-golden/* text eol=lf
brain/src/test/resources/brain-corpus/* text eol=lf

# The genre atlas (stage 2b): the asset is binary and byte-identical in both apps; its sources, hand tables and pinned hash are LF
# everywhere so a rebuild gives the same bytes on every machine.
app/src/main/assets/genre-atlas-v1.json.gz binary
brain/src/test/resources/atlas/*.sha256 text eol=lf
tools/atlas/sources/* text eol=lf
tools/atlas/hand/* text eol=lf
app/src/test/resources/knowledge/* text eol=lf

# Song Tap's golden vectors are compared byte for byte, here and in the iOS repo (Fixtures/songtap). Always LF.
songtap/src/test/resources/songtap-golden/* text eol=lf
