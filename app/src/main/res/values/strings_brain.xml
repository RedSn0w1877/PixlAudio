    <!-- How picks work (8.9) -->
    <string name="brain_how_picks_work">How picks work</string>
    <string name="brain_how_intro">Picks are based on what you play: what you finish, what you skip and what you save.</string>
    <string name="brain_promise_paid_title">Nobody can pay to be in your picks</string>
    <string name="brain_promise_repeat_title">Less repetition</string>
    <string name="brain_promise_repeat_body">A song is never in two mixes on the same day, and a new song you skipped three times stays away for 60 days.</string>
    <string name="brain_promise_why_title">You can see why, and change it</string>
    <string name="brain_promise_why_body">A pick shows why it is there when there is a reason to give. Changes apply from the next track and can be undone.</string>
    <string name="brain_promise_playlists_title">Nothing is slipped into your playlists</string>
    <string name="brain_promise_playlists_body">Picks are never added to your playlists or your library. Autoplay has an off switch, and a station plays until you start something else.</string>
    <string name="brain_promise_phone_title">It stays on your phone</string>
    <string name="brain_promise_phone_body">Looking up songs and facts contacts public music catalogues without an account; they see an IP address and the artist or song looked up. The assistant\'s cloud mode sends the conversation.</string>
    <string name="brain_how_autoplay_title">Autoplay</string>
    <string name="brain_how_autoplay_body">Keeps playing when your queue ends</string>
    <string name="brain_how_taste_changes">Taste changes</string>
    <string name="brain_how_taste_changes_body">Everything you told the picks, with undo</string>

