    <!-- Endless Listening intro (three pages) -->
    <string name="endless_eyebrow">ENDLESS LISTENING</string>
    <string name="endless_intro_skip">Skip</string>
    <string name="endless_intro_next">Next</string>
    <string name="endless_intro2_title_1a">Press play.</string>
    <string name="endless_intro2_title_1b">Done. Forever.</string>
    <string name="endless_intro2_body_1">A station that keeps going, picked one song at a time from what you actually like. No queue to babysit.</string>
    <string name="endless_intro2_title_2a">Meet your</string>
    <string name="endless_intro2_title_2b">hype host.</string>
    <string name="endless_intro2_body_2">Between songs your host drops a quick note: why this one, what\'s coming, a bit of backstory. Swipe it away, or turn notes off.</string>
    <string name="endless_intro2_title_3a">Steer it</string>
    <string name="endless_intro2_title_3b">out loud.</string>
    <string name="endless_intro2_body_3">Ask the host for “more upbeat” or “something new” and the station bends to fit. Every like and skip counts too.</string>
