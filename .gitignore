# Ad hoc per-session file backups and QA/build scratch output — git history is the real
# backup now; these were safety copies made before git existed in this checkout.
/backups/

# Lyric forced-alignment model (~360MB) — exceeds GitHub's 100MB per-file push limit.
# Stays on disk and is bundled into the APK by Gradle exactly as before; it's just not
# tracked in git. Distributed as a release asset alongside the APK, not via git history.
app/src/main/assets/tais/*.onnx
